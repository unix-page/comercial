rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function hasProfile() { return signed() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    // Compatibilidade com perfis 'usuarios' já existentes: ativo ausente = ativo.
    function active() { return hasProfile() && profile().get('ativo', true) == true; }
    function admin() { return active() && profile().get('papel', '') == 'admin'; }
    function crf() { return active() && profile().get('papel', '') in ['admin', 'usuario', 'crf']; }
    function validKey(k) { return k.matches('^[0-9]{44}$'); }
    function validCnpj(c) { return c.matches('^[0-9]{14}$'); }

    // Autocadastro permitido SOMENTE do próprio perfil, normal e ativo.
    // E-mail deve estar verificado. Não se pode autoatribuir admin ou outros papéis.
    function selfRegistration(uid) {
      return signed()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'nome', 'email', 'papel', 'ativo', 'origem', 'criadoEm'
        ])
        && request.resource.data.keys().hasAll([
          'nome', 'email', 'papel', 'ativo', 'origem', 'criadoEm'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 120
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.papel == 'usuario'
        && request.resource.data.ativo == true
        && request.resource.data.origem == 'autocadastro'
        && request.resource.data.criadoEm == request.time;
    }
    // Usuário existente só pode alterar seu nome de exibição e data da edição.
    // Não pode modificar papel, ativo, email, origem ou quaisquer permissões.
    function selfNameUpdate(uid) {
      return signed()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && resource.data.get('ativo', true) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'atualizadoEm'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 120
        && request.resource.data.atualizadoEm == request.time;
    }
    match /usuarios/{uid} {
      allow get: if signed() && (request.auth.uid == uid || admin());
      allow list, delete: if admin();
      allow update: if admin() || selfNameUpdate(uid);
      allow create: if admin() || selfRegistration(uid);
    }
    match /compradores_v2/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false; // usar ativo:false para manter auditoria
    }
    match /fornecedores_v2/{cnpj} {
      allow read: if active();
      // Operadores CRF podem vincular compradores e corrigir a razão social
      // para o CNPJ atual. Não podem alterar status, CNPJ ou campos fiscais.
      allow create: if admin() || (
        crf() && validCnpj(cnpj) && request.resource.data.cnpj == cnpj &&
        request.resource.data.razaoSocial is string && request.resource.data.razaoSocial.size() >= 3 &&
        request.resource.data.razaoSocial.size() <= 200 &&
        request.resource.data.origemRazaoSocial in ['infradesk', 'manual'] &&
        request.resource.data.compradorIds is list && request.resource.data.compradorIds.size() <= 60 &&
        request.resource.data.ativo == true &&
        request.resource.data.atualizadoPor == request.auth.uid &&
        request.resource.data.keys().hasOnly(['cnpj','razaoSocial','nomeInfradesk',
          'origemRazaoSocial','compradorIds','ativo','criadoEm','atualizadoEm','atualizadoPor'])
      );
      allow update: if admin() || (
        crf() && validCnpj(cnpj) && resource.data.cnpj == cnpj &&
        request.resource.data.cnpj == cnpj &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'razaoSocial','compradorIds','origemRazaoSocial','atualizadoEm','atualizadoPor'
        ]) &&
        request.resource.data.razaoSocial is string &&
        request.resource.data.razaoSocial.size() >= 3 &&
        request.resource.data.razaoSocial.size() <= 200 &&
        request.resource.data.compradorIds is list &&
        request.resource.data.compradorIds.size() <= 60 &&
        request.resource.data.origemRazaoSocial in ['infradesk', 'manual', 'importacao_json'] &&
        request.resource.data.atualizadoPor == request.auth.uid &&
        request.resource.data.atualizadoEm is timestamp
      );
      allow delete: if false;
    }
    match /tipos_divergencia_v2/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }
    // Respostas por setor: somente admins alteram os textos/efeitos.
    // Operadores ativos consultam para registrar retornos no Infradesk.
    match /respostas_v2/{id} {
      allow read: if active();
      allow create, update: if admin()
        && request.resource.data.setor in ['fiscal', 'comercial', 'cadastro']
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.nome.size() <= 120
        && request.resource.data.efeito in ['validar', 'concluir', 'devolver'];
      allow delete: if false;
    }
    match /notas_v2/{chave} {
      allow read: if active();
      allow create: if crf() && validKey(chave) && request.resource.data.chave == chave;
      allow update: if crf() && resource.data.chave == chave && request.resource.data.chave == chave;
      allow delete: if false;
    }
    match /divergencias_v2/{id} {
      allow read: if active();
      allow create: if crf() && validKey(request.resource.data.chave) &&
        request.resource.data.abertoPor == request.auth.uid;
      allow update: if crf() && request.resource.data.chave == resource.data.chave &&
        request.resource.data.abertoPor == resource.data.abertoPor &&
        request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }
    match /eventos_v2/{id} {
      allow read: if active();
      allow create: if crf() && validKey(request.resource.data.chave) &&
        request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false; // trilha de auditoria imutável
    }
    match /passagens_v2/{id} {
      allow read: if active();
      allow create: if crf() && validKey(request.resource.data.chave) &&
        request.resource.data.criadoPor == request.auth.uid && request.resource.data.fimEm == null;
      // Uma resposta fecha o relógio UMA vez. A correção posterior do comprador
      // muda SOMENTE atribuição, mesmo em passagens encerradas, nunca as datas.
      allow update: if crf() && (
        (
          resource.data.fimEm == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fimEm','fechadoPor','fechamento','respostaId','respostaNome','atribuicaoTempo'
          ]) &&
          request.resource.data.fimEm is timestamp &&
          request.resource.data.fechamento == 'resposta' &&
          request.resource.data.respostaId is string &&
          request.resource.data.respostaNome is string &&
          request.resource.data.atribuicaoTempo in ['fiscal','comercial','cadastro','crf_erro']
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'compradorId','compradorNome'
          ]) &&
          request.resource.data.compradorId is string &&
          request.resource.data.compradorId.size() > 0 &&
          exists(/databases/$(database)/documents/compradores_v2/$(request.resource.data.compradorId)) &&
          get(/databases/$(database)/documents/compradores_v2/$(request.resource.data.compradorId)).data.get('ativo',true) == true &&
          request.resource.data.compradorNome == get(/databases/$(database)/documents/compradores_v2/$(request.resource.data.compradorId)).data.nome
        )
      );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
